# SmartKey — environment variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# Supabase project: Settings → API Keys. Prefer sb_publishable_/sb_secret_
# over legacy eyJ... JWTs — those two rotate independently, the legacy pair
# doesn't (rotating one logs everyone out).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key

# Server-side only, bypasses RLS. Supabase Edge Functions read their own copy
# named SERVICE_ROLE_KEY (no prefix) from their own secret store, not here.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# Gmail SMTP, used for OTP/activation/notification emails. App password (not
# your login password): https://myaccount.google.com/apppasswords
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Bearer token pg_cron sends to scheduled endpoints (e.g. weekend-reminders).
# Store the same value in Supabase Vault as weekend_cron_secret.
CRON_SECRET=your-cron-secret

BLOB_READ_WRITE_TOKEN=your-vercel-blob-read-write-token

# Risk engine fallback tier bounds (docs/AI.md) — live values are in
# risk_tier_config, edited at /cso/settings. Per-rule weights aren't env vars.
RISK_TIER_MEDIUM_MIN=4
RISK_TIER_HIGH_MIN=7
RISK_MAX_DAILY_REQUESTS=5

# Ink-region Jaccard distance signature-mismatch threshold. Don't lower
# without reading docs/AI.md — 0.15 (pre-2026-08-02) rejects genuine
# signatures.
SIGNATURE_DIFF_THRESHOLD=0.55

# Plausibility pre-check (Dean onboarding + profile signature/stamp
# replacement only): whole-image ink coverage % a signature/stamp upload
# must fall between to be accepted. See docs/AI.md — wants calibration
# against real samples during the pilot.
SIGNATURE_MIN_INK_COVERAGE_PCT=0.1
SIGNATURE_MAX_INK_COVERAGE_PCT=30

OPERATING_HOURS_START=06:00
OPERATING_HOURS_END=22:00

# E2E test accounts (bun run test:e2e) — one ACTIVE account per role. CSO/
# DEAN/VERIFIER need a real OTP round-trip via the E2E_OTP_IMAP_* mailbox
# below (no test-mode MFA bypass exists); REQUESTER skips MFA and needs only
# its own pair. See docs/E2E_OTP_SETUP.md. In CI these come from repo
# secrets (.github/workflows/e2e.yml) — real values go in .env.local only.
TEST_CSO_EMAIL=
TEST_CSO_PASSWORD=
TEST_DEAN_EMAIL=
TEST_DEAN_PASSWORD=
TEST_VERIFIER_EMAIL=
TEST_VERIFIER_PASSWORD=
TEST_REQUESTER_EMAIL=
TEST_REQUESTER_PASSWORD=

# Shared Gmail mailbox tests/e2e/utils/otp.ts reads CSO/DEAN/VERIFIER OTP
# codes from over IMAP, via "+" address tags — one login for all three roles.
E2E_OTP_IMAP_USER=
E2E_OTP_IMAP_APP_PASSWORD=

# Post-deploy smoke test (docs/SMOKE_TEST_SETUP.md) — a dedicated, low-
# privilege REQUESTER account, separate purpose from TEST_REQUESTER_* above
# even if you reuse the same account for both.
SMOKE_REQUESTER_EMAIL=
SMOKE_REQUESTER_PASSWORD=
