# SmartKey — environment variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.


# Find these in your Supabase project: Settings → API Keys
#
# Prefer the modern key formats over the legacy `eyJ...` JWTs. Legacy anon and
# service_role are a single pair signed by one project JWT secret, so neither can be
# rotated without invalidating the other AND logging every user out. The
# sb_publishable_ / sb_secret_ pair rotates independently.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key

# Secret key — server-side only, never exposed to the browser. Bypasses RLS.
# Do NOT prefix with NEXT_PUBLIC_. The variable keeps its historical name; the
# value should be an sb_secret_... key.
#
# Supabase Edge Functions read this from their OWN secret store, not from here, and
# `SUPABASE_*` is a reserved namespace there — so the Edge Function secret must be
# named SERVICE_ROLE_KEY (no prefix). See supabase/functions/*/index.ts.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key

# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Gemini model used for shift-report generation. Defaults to the latest stable
GEMINI_MODEL=gemini-3.5-flash

# Gmail SMTP — used for OTP, activation, and notification emails.
# GMAIL_USER: the sending Gmail address.
# GMAIL_APP_PASSWORD: a Gmail App Password (not your login password).
#   Generate one at: https://myaccount.google.com/apppasswords
# Server-side only.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Shared secret guarding scheduled (pg_cron) endpoints, e.g.
# POST /api/cron/weekend-reminders. Server-side only. pg_cron sends this as a
# bearer token, reading it from Supabase Vault — store the same value there once:
#   select vault.create_secret('<this value>', 'weekend_cron_secret');
CRON_SECRET=your-cron-secret

# Risk engine (see docs/AI.md).
#
# Per-rule weights and enabled flags are NOT env vars. They live in the
# risk_rule_config / risk_tier_config tables and the CSO edits them at
# /cso/settings → "Risk rules". The RISK_WEIGHT_* variables this file used to list
# were read by nothing — removed rather than left to mislead.
#
# These tier bounds are only the fallback DEFAULT, used if the config read fails.
# The live values come from risk_tier_config. Note the naming: MIN, not MAX —
# src/lib/ai/risk/thresholds.ts reads RISK_TIER_MEDIUM_MIN / RISK_TIER_HIGH_MIN.
RISK_TIER_MEDIUM_MIN=4
RISK_TIER_HIGH_MIN=7

# Genuinely env-only, read directly by src/lib/ai/risk/rules.ts.
RISK_MAX_DAILY_REQUESTS=5

# Maximum allowable mismatch ratio before a signature is held for CSO review.
#
# Scored as a Jaccard distance over the INK REGION, not the whole canvas (corrected
# 2026-08-02 — the old whole-canvas maths made the threshold unreachable and passed
# every forgery). 0.15 is the pre-correction value and now rejects genuine
# signatures: the same signature with a heavier pen scores ~31%. Measured
# separation is genuine 0-31% vs forged 100%, so 0.55 sits in the gap.
# Do not lower without re-reading docs/AI.md.
SIGNATURE_DIFF_THRESHOLD=0.55

# Default hours per zone (24h format). Overridable from CSO settings.
OPERATING_HOURS_START=06:00
OPERATING_HOURS_END=22:00
