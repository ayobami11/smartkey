# SmartKey — environment variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.


# Find these in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-side only, never exposed to the browser.
# Used only in Edge Functions. Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Gemini model used for shift-report generation. Defaults to the latest stable
GEMINI_MODEL=gemini-3.5-flash

# https://resend.com/api-keys
# Server-side only.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=smartkey@yourdomain.com

# Shared secret guarding scheduled (pg_cron) endpoints, e.g.
# POST /api/cron/weekend-reminders. Server-side only. pg_cron sends this as a
# bearer token, reading it from Supabase Vault — store the same value there once:
#   select vault.create_secret('<this value>', 'weekend_cron_secret');
CRON_SECRET=your-cron-secret

# Weights for the rule-based risk scoring engine (see docs/AI.md).
# Integer weights; tier LOW <= 3, MEDIUM <= 6, HIGH > 6.
RISK_WEIGHT_OUTSIDE_HOURS=3
RISK_WEIGHT_OUTSTANDING_KEY=5
RISK_WEIGHT_WEEKEND_WITHOUT_MEMO=4
RISK_WEIGHT_EXCESS_FREQUENCY=2
RISK_WEIGHT_NOT_WHITELISTED=5

# Tier boundary overrides (defaults match docs/AI.md)
RISK_TIER_LOW_MAX=3
RISK_TIER_MEDIUM_MAX=6

# Maximum allowable pixel mismatch ratio before a CSO alert is raised.
# Default: 0.15 (15%). Increase if HOD signatures vary significantly.
SIGNATURE_DIFF_THRESHOLD=0.15

# Default hours per zone (24h format). Overridable from CSO settings.
OPERATING_HOURS_START=06:00
OPERATING_HOURS_END=22:00
